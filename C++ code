#include<bits/stdc++.h>
vector<int> findSchedule(int numCourses, vector<pair<int, int>> &prerequisites)
{
    // Write your code here.
    int n=numCourses;
    vector<vector<int>>adjList(n+1);
    vector<int>indegree(n+1,0);
    for(int i=0;i<prerequisites.size();i++){
        int u=prerequisites[i].second;
        int v=prerequisites[i].first;
        adjList[u].push_back(v);
        indegree[v]++;
    }
    queue<int>q;
    for(int i=1;i<n+1;i++){
        if(indegree[i]==0)q.push(i);
    }
    vector<int>ans;
    while(!q.empty()){
        int front=q.front();
        q.pop();
        ans.push_back(front);
        for(int num:adjList[front]){
            indegree[num]--;
            if(indegree[num]==0)q.push(num);
        }
    }
    if(ans.size()==n)return ans;
    return {};
}
